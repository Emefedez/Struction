// Static ground. Its `Shape` is both the collider and the mesh; ground that hides the player gets
// a cut-out along the camera's line of sight.
{
  "components": {
    "RigidBody": "Static",
    "Surface": { "friction": 1.0, "restitution": 1.0, "drag": 0.0 },
    "Look": { "finish": "Ground" }
  }
}
