// The README's Milestone 1 validation scene: floors with different surfaces, a pushable cube, a
// water pool with a floating cube, an overhead camera zone, a small gravity planet and a knight
// standing guard.
{
  "zones": { "Playground": { "position": [0, 0, 0] } },
  "spawnerList": {
    "environment": {
      "zone": "Playground",
      "position": [0, 0, 0],
      "spawns": {
        "gravity": { "definition": "regions/scene_gravity" }
      }
    },
    // Tiles are half a meter thick with their top at y = 0.
    "floors": {
      "zone": "Playground",
      "position": [0, -0.25, 0],
      "spawns": {
        "stone": { "definition": "terrains/stone", "offset": [0, 0, 5] },
        "slippery": { "definition": "terrains/slippery", "offset": [0, 0, -7] },
        "approach": { "definition": "terrains/approach", "offset": [0, 0, -16.5] }
      }
    },
    "pushable": {
      "zone": "Playground",
      "position": [0, 0.8, 3],
      "spawns": {
        "cube": { "definition": "props/pushable_cube"}
      }
    },
    // To the right of the start. The water's surface is level with the floors.
    "pool": {
      "zone": "Playground",
      "position": [10.5, 0, -5],
      "spawns": {
        "water": { "definition": "regions/water_pool", "offset": [0, -1, 0] },
        "floor": {
          "definition": "terrains/pool_floor",
          "offset": [0, -2.75, 0]
        },
        "floating_cube": { "definition": "props/floating_cube", "offset": [0, 1, 0] } //TODO: add a way to load a .jsonc for the definition of these spawns instead of inline definitions, like player
      }
    },
    // Over the slippery tile, on the way to the planet.
    "overhead_camera": {
      "zone": "Playground",
      "position": [0, 1, -8],
      "spawns": {
        "zone": { "definition": "regions/overhead_camera" },
        "left_post": { "definition": "props/marker_post", "offset": [-5.8, 0, 0] },
        "right_post": { "definition": "props/marker_post", "offset": [5.8, 0, 0] },
        "middle_post": {
          "definition": "props/marker_post",
          "offset": [3.0893917083740234, 0.0, 0.07469367980957031],
          "overrides": {
            "components": {
              "Shape": {
                "Box": {
                  "size": [1.49, 2.0, 0.11999999731779099]
                }
              }
            }
          }
        }
      }
    },
    "planet": {
      "zone": "Playground",
      "position": [0, 4, -20],
      "spawns": {
        "planet": {
          "definition": "terrains/planet",
          "offset": [-0.09756612777709961, 0.0, -2.0403976440429688],
          "overrides": {
            "components": {
              "GravityField": {
                "kind": {
                  "Radial": {
                    "strength": 24.0
                  }
                },
                "volume": {
                  "Sphere": {
                    "radius": 5.0
                  }
                }
              },
              "Shape": {
                "Sphere": {
                  "radius": 4.0
                }
              }
            }
          }
        }
      }
    },
    "start": {
      "zone": "Playground",
      "position": [0, 0, 8],
      "spawns": {
        "player": {
          "definition": "characters/player",
          "offset": [1.2599530220031738, 0.8999999761581421, -0.19558143615722656],
          "overrides": {
            "components": {
              "Attack": {}
            }
          }
        }
      }
    },
    // Beside the pushable cube.
    "guard": {
      "zone": "Playground",
      "position": [-3, 0.9, 3],
      "spawns": {
        "sentry": {
          "definition": "characters/sentry",
          "offset": [0.0, 1.100000023841858, 0.0]
        }
      }
    }
  }
}
