// Preserve saved definition paths after renames: case-colliding directories separated for macOS,
// the player moved under `characters/`, and the engine's terrain and gravity reorganized.
{
  "aliases": {
    "ground": "terrain",
    "gravity": "fields",
    "terrain": "terrains",
    "fields/scene": "regions/scene_gravity",
    "Ground": "Terrain",
    "Gravity": "Region",
    "Player": "characters/player"
  }
}
