    "Player": {},
    "Humanoid": {},
    "CharacterController": {},
    "RollAbility": { "duration": 0.65, "peak_speed": 10.0, "recovery": 0.2 },
    "PlayerControlled": {},
    "CameraTarget": {}
  }
}
